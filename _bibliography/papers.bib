	author = {Jung, Vincent and Vincent-Cuaz, Cédric and Tumescheit, Charlotte and Fournier, Lisa and Darsinou, Marousa and Xu, Zhi Ming and Saadat, Ali and Wang, Yiran and Tsantoulis, Petros and Michielin, Olivier and Fellay, Jacques and Patani, Rickie and Ramos, Andres and Frossard, Pascal and Hastings, Janna and Riccio, Antonella and van der Plas, Lonneke and Luisier, Raphaëlle},
