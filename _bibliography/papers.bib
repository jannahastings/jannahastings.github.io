@article{west_development_2019,
	title = {Development of a formal system for representing behaviour-change theories},
	volume = {3},
	copyright = {2019 The Author(s), under exclusive licence to Springer Nature Limited},
	issn = {2397-3374},
	url = {https://www.nature.com/articles/s41562-019-0561-2},
	doi = {10.1038/s41562-019-0561-2},
	abstract = {Use of natural language to represent behaviour-change theories has resulted in lack of clarity and consistency, hindering comparison, integration, development and use. This paper describes development of a formal system for representing behaviour-change theories that aims to improve clarity and consistency. A given theory is represented in terms of (1) its component constructs (for example, ‘self-efficacy’, ‘perceived threat’ or ‘subjective norm’), which are labelled and defined, and (2) relationships between pairs of constructs, which may be causal, structural or semantic. This formalism appears adequate to represent five commonly used theories (health belief model, information–motivation–behavioural skill model, social cognitive theory, theory of planned behaviour and the trans-theoretical model). Theory authors and experts judged that the system was able to capture the main propositions of the theories. Following this proof of concept, the next step is to assess how far the system can be applied to other theories of behaviour change.},
	language = {en},
	number = {5},
	urldate = {2020-11-17},
	journal = {Nature Human Behaviour},
	author = {West, Robert and Godinho, Cristina A. and Bohlen, Lauren Connell and Carey, Rachel N. and Hastings, Janna and Lefevre, Carmen E. and Michie, Susan},
	month = may,
	year = {2019},
	note = {Number: 5
Publisher: Nature Publishing Group},
	pages = {526--536},
	altmetric={true},
	google_scholar_id={V3AGJWp-ZtQC}
}

@article{norris_scoping_2019,
	title = {A scoping review of ontologies related to human behaviour change},
	volume = {3},
	copyright = {2019 The Author(s), under exclusive licence to Springer Nature Limited},
	issn = {2397-3374},
	url = {https://www.nature.com/articles/s41562-018-0511-4},
	doi = {10.1038/s41562-018-0511-4},
	abstract = {Ontologies are classification systems specifying entities, definitions and inter-relationships for a given domain, with the potential to advance knowledge about human behaviour change. A scoping review was conducted to: (1) identify what ontologies exist related to human behaviour change, (2) describe the methods used to develop these ontologies and (3) assess the quality of identified ontologies. Using a systematic search, 2,303 papers were identified. Fifteen ontologies met the eligibility criteria for inclusion, developed in areas such as cognition, mental disease and emotions. Methods used for developing the ontologies were expert consultation, data-driven techniques and reuse of terms from existing taxonomies, terminologies and ontologies. Best practices used in ontology development and maintenance were documented. The review did not identify any ontologies representing the breadth and detail of human behaviour change. This suggests that advancing behavioural science would benefit from the development of a behaviour change intervention ontology.},
	language = {en},
	number = {2},
	urldate = {2020-11-17},
	journal = {Nature Human Behaviour},
	author = {Norris, Emma and Finnerty, Ailbhe N. and Hastings, Janna and Stokes, Gillian and Michie, Susan},
